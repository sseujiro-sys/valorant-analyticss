{
  "name": "valorant-analytics-v1",
  "version": "1.0.0",
  "description": "VALORANT Analytics demo dashboard",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.community.valorantanalytics",
    "productName": "VALORANT Analytics",
    "win": {
      "target": "nsis"
    },
    "files": [
      "index.html",
      "src/**/*",
      "electron/**/*",
      "package.json"
    ]
  }
}